{
  "title": "LinkedIn Batch Wrapper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "profileUrls": {
      "type": "array",
      "editor": "stringList"
    },
    "batchSize": {
      "type": "integer",
      "default": 5
    },
    "maxPostsPerProfile": {
      "type": "integer",
      "default": 12
    },
    "includeReposts": {
      "type": "boolean",
      "default": false
    },
    "onlyPosts": {
      "type": "boolean",
      "default": true
    },
    "dedupeByPostUrl": {
      "type": "boolean",
      "default": true
    },
    "debug": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["profileUrls"]
}
