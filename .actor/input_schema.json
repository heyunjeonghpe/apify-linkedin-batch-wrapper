{
  "title": "LinkedIn Batch Wrapper Input",
  "description": "Input for LinkedIn batch wrapper actor",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "profileUrls": {
      "title": "LinkedIn Profile URLs",
      "description": "List of LinkedIn profiles to scrape",
      "type": "array",
      "items": {
        "type": "string"
      },
      "editor": "stringList"
    },
    "batchSize": {
      "title": "Batch Size",
      "description": "Number of profiles per batch",
      "type": "integer",
      "default": 5
    },
    "maxPostsPerProfile": {
      "title": "Max Posts Per Profile",
      "description": "Maximum number of posts per profile",
      "type": "integer",
      "default": 12
    },
    "includeReposts": {
      "title": "Include Reposts",
      "description": "Include reposted content",
      "type": "boolean",
      "default": false
    },
    "onlyPosts": {
      "title": "Only Posts",
      "description": "Only include original posts",
      "type": "boolean",
      "default": true
    },
    "dedupeByPostUrl": {
      "title": "Deduplicate Posts",
      "description": "Remove duplicate posts",
      "type": "boolean",
      "default": true
    },
    "debug": {
      "title": "Debug Mode",
      "description": "Enable debug logs",
      "type": "boolean",
      "default": false
    }
  },
  "required": ["profileUrls"]
}
